{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enemy",
  "type": "object",
  "required": ["id", "type", "archetype", "logic", "presentation"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^enemy_" },
    "type": { "type": "string", "const": "enemy" },
    "archetype": {
      "type": "string",
      "enum": ["runner", "grunt", "armored", "flyer", "swarm", "boss"]
    },
    "logic": {
      "type": "object",
      "required": ["baseHP", "speed", "flying", "goldReward", "isBoss"],
      "additionalProperties": false,
      "properties": {
        "baseHP": { "type": "number", "minimum": 1 },
        "speed": { "type": "number", "minimum": 0 },
        "armor": { "type": "number", "minimum": 0, "maximum": 1 },
        "flying": { "type": "boolean" },
        "spawnCount": { "type": "integer", "minimum": 1 },
        "goldReward": { "type": "number", "minimum": 0 },
        "isBoss": { "type": "boolean" }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["name", "description", "sprite"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sprite": { "type": "string", "minLength": 1 }
      }
    }
  }
}

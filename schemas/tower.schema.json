{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tower",
  "type": "object",
  "required": ["id", "name", "cost", "damage", "range", "fireRate"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": "integer",
      "minimum": 0
    },
    "damage": {
      "type": "number",
      "minimum": 0
    },
    "range": {
      "type": "number",
      "minimum": 0
    },
    "fireRate": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}


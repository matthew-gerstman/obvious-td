{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wave Table",
  "type": "object",
  "required": ["id", "waves"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^wave_table_" },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wave", "enemies"],
        "additionalProperties": false,
        "properties": {
          "wave": { "type": "integer", "minimum": 1 },
          "enemies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["enemyId", "count", "interval"],
              "additionalProperties": false,
              "properties": {
                "enemyId": { "type": "string", "pattern": "^enemy_" },
                "count": { "type": "integer", "minimum": 1 },
                "interval": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}

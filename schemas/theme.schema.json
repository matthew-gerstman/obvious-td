{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theme",
  "type": "object",
  "required": ["theme", "overrides"],
  "additionalProperties": false,
  "properties": {
    "theme": { "type": "string", "minLength": 1 },
    "overrides": {
      "type": "object",
      "patternProperties": {
        ".+": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "sprite": { "type": "string", "minLength": 1 },
            "projectileSprite": { "type": "string", "minLength": 1 },
            "backgroundSprite": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "subtitle", "bgColor", "titleColor", "buttonBg", "buttonBgSelected", "buttonBorder", "buttonBorderSelected"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "subtitle": { "type": "string", "minLength": 1 },
            "bgColor": { "type": "string", "minLength": 1 },
            "titleColor": { "type": "string", "minLength": 1 },
            "buttonBg": { "type": "string", "minLength": 1 },
            "buttonBgSelected": { "type": "string", "minLength": 1 },
            "buttonBorder": { "type": "string", "minLength": 1 },
            "buttonBorderSelected": { "type": "string", "minLength": 1 }
          }
        },
        "hud": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currencyLabel", "livesLabel", "currencyColor", "livesColor", "waveColor", "bgColor", "buttonBg", "buttonBorder"],
          "properties": {
            "currencyLabel": { "type": "string", "minLength": 1 },
            "livesLabel": { "type": "string", "minLength": 1 },
            "currencyColor": { "type": "string", "minLength": 1 },
            "livesColor": { "type": "string", "minLength": 1 },
            "waveColor": { "type": "string", "minLength": 1 },
            "bgColor": { "type": "string", "minLength": 1 },
            "buttonBg": { "type": "string", "minLength": 1 },
            "buttonBorder": { "type": "string", "minLength": 1 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["victoryText", "defeatText", "victoryColor", "defeatColor", "bgColor", "returnText"],
          "properties": {
            "victoryText": { "type": "string", "minLength": 1 },
            "defeatText": { "type": "string", "minLength": 1 },
            "victoryColor": { "type": "string", "minLength": 1 },
            "defeatColor": { "type": "string", "minLength": 1 },
            "bgColor": { "type": "string", "minLength": 1 },
            "returnText": { "type": "string", "minLength": 1 }
          }
        },
        "towerUI": {
          "type": "object",
          "additionalProperties": false,
          "required": ["panelBg", "panelBorder", "towerColors"],
          "properties": {
            "panelBg": { "type": "string", "minLength": 1 },
            "panelBorder": { "type": "string", "minLength": 1 },
            "towerColors": {
              "type": "object",
              "patternProperties": {
                ".+": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "pathTiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spriteDir"],
          "properties": {
            "spriteDir": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
